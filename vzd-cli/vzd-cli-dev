#!/bin/bash
# Resolve gradlew relative to this script, not the caller's working directory,
# so it always uses this project's wrapper regardless of where it is invoked from.
GRADLEW="$(cd "$(dirname "$0")/.." && pwd)/gradlew"
if [ -z "$*" ]
then
  "$GRADLEW" -q run
else
  "$GRADLEW" -q run --args="$*"
fi
